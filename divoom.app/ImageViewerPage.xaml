<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="divoom.app.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:divoom.app"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppChromeBrush}">

    <Page.Resources>
        <MenuFlyout x:Name="ImageContextMenu">
            <MenuFlyoutItem Text="Send to device"
                            Click="SendToDevice_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete"
                            Click="DeleteImage_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Images"
                       FontSize="20"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

            <Button x:Name="UploadButton"
                    IsEnabled="{x:Bind IsNotLoading, Mode=OneWay}"
                    Click="UploadButton_Click"
                    Content="Upload" />

            <Button x:Name="ReloadButton"
                    IsEnabled="{x:Bind IsNotLoading, Mode=OneWay}"
                    Click="ReloadButton_Click">
                <Grid>
                    <TextBlock Text="Reload"
                               Visibility="{x:Bind LoadButtonTextVisibility, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind LoadingIndicatorVisibility, Mode=OneWay}">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Text="Loading…" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>

            </StackPanel>
        </Grid>

        <!-- Send feedback bar -->
        <InfoBar x:Name="SendFeedbackBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="False" />

        <!-- Image grid -->
        <ScrollViewer Grid.Row="2"
                      Visibility="{x:Bind ImageListVisibility, Mode=OneWay}">
            <ItemsRepeater x:Name="ImageRepeater"
                           ItemsSource="{x:Bind Images}"
                           Margin="8"
                           Tapped="ImageRepeater_Tapped"
                           RightTapped="ImageRepeater_RightTapped">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="128"
                                       MinItemHeight="128"
                                       MinColumnSpacing="4"
                                       MinRowSpacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:ImageFileInfo">
                        <Border BorderBrush="{ThemeResource AppAccentBrush}"
                                BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}">
                            <Image Width="128"
                                   Height="128"
                                   Source="{x:Bind Source, Mode=OneWay}"
                                   Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Loading placeholder -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Visibility="{x:Bind LoadingPlaceholderVisibility, Mode=OneWay}">
            <ProgressRing Width="40" Height="40" IsActive="True" />
            <TextBlock Text="Loading images…"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xEB9F;"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="No images found"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
            <TextBlock Text="Generated images will appear here automatically.&#10;You can also add a folder in Settings."
                       FontSize="13"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Reload"
                    HorizontalAlignment="Center"
                    Click="ReloadButton_Click"
                    Margin="0,6,0,0" />
        </StackPanel>

    </Grid>
</Page>
