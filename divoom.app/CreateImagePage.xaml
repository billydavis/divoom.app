<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="divoom.app.CreateImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppChromeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Generated image results -->
        <ScrollViewer Grid.Row="0"
                      x:Name="ResultsScrollViewer"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel"
                        Spacing="16"
                        Padding="20,16" />
        </ScrollViewer>

        <!-- Bottom bar: error + progress + prompt input -->
        <StackPanel Grid.Row="1" Spacing="8" Padding="20,0,20,16">

            <!-- Error -->
            <Border x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    BorderBrush="#C42B1C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Error"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#C42B1C" />
                        <TextBox x:Name="ErrorTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="12"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="✕"
                            VerticalAlignment="Top"
                            Width="32" Height="32"
                            Padding="0"
                            Click="ErrorDismiss_Click" />
                </Grid>
            </Border>

            <!-- Progress -->
            <ProgressRing x:Name="GeneratingRing"
                          IsActive="False"
                          Visibility="Collapsed"
                          Width="28" Height="28"
                          HorizontalAlignment="Left" />

            <!-- Prompt input with provider picker overlaid in lower-right -->
            <Border CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <Grid>
                    <TextBox x:Name="PromptBox"
                             PlaceholderText="Describe the image you want to generate..."
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MinHeight="120"
                             Padding="12,10,148,50"
                             BorderThickness="0"
                             Background="Transparent"
                             KeyDown="PromptBox_KeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>
                    <ComboBox x:Name="ProviderComboBox"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              MinWidth="120"
                              Margin="0,0,8,8"
                              FontSize="12"
                              SelectionChanged="ProviderComboBox_SelectionChanged" />
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</Page>
