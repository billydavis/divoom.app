<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="divoom.app.CreateImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppChromeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="20,16">

            <TextBlock Text="Create Image"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- AI Provider -->
            <StackPanel Spacing="6">
                <TextBlock Text="AI Provider"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="ProviderComboBox"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ProviderComboBox_SelectionChanged" />
            </StackPanel>

            <!-- API Key -->
            <StackPanel Spacing="6">
                <TextBlock Text="API Key"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <PasswordBox x:Name="ApiKeyBox"
                             PlaceholderText="Paste your API key"
                             PasswordChanged="ApiKeyBox_PasswordChanged" />
            </StackPanel>

            <!-- Prompt -->
            <StackPanel Spacing="6">
                <TextBlock Text="Prompt"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="PromptBox"
                         PlaceholderText="Describe the image you want to generate..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         MaxHeight="160" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="GenerateButton"
                        Content="Generate"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="GenerateButton_Click" />
                <Button x:Name="ClearButton"
                        Content="Clear"
                        Click="ClearButton_Click" />
            </StackPanel>

            <!-- Progress -->
            <ProgressRing x:Name="GeneratingRing"
                          IsActive="False"
                          Visibility="Collapsed"
                          Width="32" Height="32"
                          HorizontalAlignment="Left" />

            <!-- Error feedback (read-only TextBox so the message can be selected and copied) -->
            <Border x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    BorderBrush="#C42B1C"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Error"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#C42B1C" />
                        <TextBox x:Name="ErrorTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="12"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="✕"
                            VerticalAlignment="Top"
                            Width="32" Height="32"
                            Padding="0"
                            Click="ErrorDismiss_Click" />
                </Grid>
            </Border>

            <!-- Preview -->
            <Border x:Name="PreviewBorder"
                    Visibility="Collapsed"
                    CornerRadius="4"
                    BorderBrush="{ThemeResource AppAccentBrush}"
                    BorderThickness="1">
                <Image x:Name="PreviewImage"
                       MaxHeight="320"
                       Stretch="Uniform" />
            </Border>

            <!-- Save to Gallery -->
            <Button x:Name="SaveButton"
                    Content="Save to Gallery"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    Click="SaveButton_Click" />

            <!-- Save confirmation -->
            <InfoBar x:Name="SaveConfirmBar"
                     Severity="Success"
                     Title="Saved to Gallery"
                     IsOpen="False"
                     IsClosable="True" />

        </StackPanel>
    </ScrollViewer>
</Page>
