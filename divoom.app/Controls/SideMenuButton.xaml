<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="divoom.app.SideMenuButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Margin="0 3" Tag="{x:Bind Text, Mode=OneWay}">
        <StackPanel  Orientation="Vertical" Padding="0 6"  HorizontalAlignment="Center"     >
            <FontIcon  FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="{x:Bind Glyph, Mode=OneWay}"></FontIcon>
            <TextBlock  FontSize="9" Text="{x:Bind Text, Mode=OneWay}" Margin="0 3" HorizontalAlignment="Stretch" ></TextBlock>
        </StackPanel>
    </Border>
</UserControl>
