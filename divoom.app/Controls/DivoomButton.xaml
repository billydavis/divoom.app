<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="divoom.app.DivoomButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:divoom.app"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <Button HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            CornerRadius="8"
            Background="{ThemeResource AppCardBrush}"
            BorderBrush="{ThemeResource AppCardBorderBrush}"
            BorderThickness="1"
            Padding="0"
            Click="CardButton_Click">

        <Button.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Remove device"
                                Icon="Delete"
                                Click="RemoveDevice_Click" />
            </MenuFlyout>
        </Button.ContextFlyout>

        <Grid>
            <!-- Selection overlay (not hit-testable) -->
            <Border x:Name="SelectionOverlay"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Background="{x:Bind SelectionOverlayBrush, Mode=OneWay}" />

            <!-- Left accent bar — only visible when this device is the active target -->
            <Rectangle Width="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       RadiusX="4" RadiusY="4"
                       Fill="{ThemeResource AppAccentBrush}"
                       Visibility="{x:Bind SelectionBarVisibility, Mode=OneWay}" />

            <!-- Card content -->
            <Grid Margin="20,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Device image -->
                <Border Grid.Row="0" Grid.Column="0"
                        Width="72" Height="72"
                        CornerRadius="6"
                        Background="{ThemeResource AppCardImageBrush}">
                    <Image Source="{x:Bind Device.Hardware, Converter={StaticResource HardwareToImageConverter}}"
                           Stretch="Uniform" />
                </Border>

                <!-- Device info -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{x:Bind Device.Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind Device.Hardware, Converter={StaticResource HardwareToNameConverter}}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Device.IpAddress, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Device.MacAddress}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Online/Offline status -->
                <StackPanel Grid.Row="0" Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Spacing="5"
                            Margin="8,2,0,0">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{x:Bind OnlineDotColor, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind OnlineStatusText, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Channel selector (Times Gate — 5 screens) -->
                <Border Grid.Row="1" Grid.ColumnSpan="3"
                        Margin="0,10,0,0"
                        Visibility="{x:Bind ChannelSelectorVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Screen:"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,4,0" />
                        <ToggleButton Content="1" Tag="0" FontSize="11" Width="28" Height="24" Padding="0"
                                      IsChecked="{x:Bind IsChannelSelected(0), Mode=OneWay}"
                                      Click="ChannelButton_Click" />
                        <ToggleButton Content="2" Tag="1" FontSize="11" Width="28" Height="24" Padding="0"
                                      IsChecked="{x:Bind IsChannelSelected(1), Mode=OneWay}"
                                      Click="ChannelButton_Click" />
                        <ToggleButton Content="3" Tag="2" FontSize="11" Width="28" Height="24" Padding="0"
                                      IsChecked="{x:Bind IsChannelSelected(2), Mode=OneWay}"
                                      Click="ChannelButton_Click" />
                        <ToggleButton Content="4" Tag="3" FontSize="11" Width="28" Height="24" Padding="0"
                                      IsChecked="{x:Bind IsChannelSelected(3), Mode=OneWay}"
                                      Click="ChannelButton_Click" />
                        <ToggleButton Content="5" Tag="4" FontSize="11" Width="28" Height="24" Padding="0"
                                      IsChecked="{x:Bind IsChannelSelected(4), Mode=OneWay}"
                                      Click="ChannelButton_Click" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

    </Button>
</UserControl>
