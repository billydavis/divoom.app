<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="divoom.app.DivoomButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:divoom.app"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Button Width="340" Height="90" CornerRadius="8" >
        <StackPanel Orientation="Horizontal" >
          
            <Border Width="90">

                <Viewbox>
                    <Image Source="{x:Bind Device.Hardware, Converter={StaticResource HardwareToImageConverter}}"/>
                    
                </Viewbox>
            </Border>


            <Border Width="230" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                
                <StackPanel Padding="8 4">
                    <TextBlock Text="{x:Bind Device.Name}" />
                    <TextBlock Text="{x:Bind Device.IpAddress}" />
                </StackPanel>
                
            </Border>

        </StackPanel>

    </Button>

</UserControl>
