<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="divoom.app.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:divoom.app">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#110B0B" />
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#1A1111" />
                    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#231717" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF5722" />
                    <Visibility x:Key="AppIconDarkVisibility">Visible</Visibility>
                    <Visibility x:Key="AppIconLightVisibility">Collapsed</Visibility>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#EFEFEF" />
                    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF5722" />
                    <Visibility x:Key="AppIconDarkVisibility">Collapsed</Visibility>
                    <Visibility x:Key="AppIconLightVisibility">Visible</Visibility>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <local:HardwareToImageConverter x:Key="HardwareToImageConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
